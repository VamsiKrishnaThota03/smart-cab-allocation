# Copy to .env and fill in real values. Never commit .env.
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/smart-cab
JWT_SECRET=replace-with-a-long-random-string
# Server-side key for the Places / Geocoding proxy routes
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Comma-separated emails that become admins when they register
ADMIN_EMAILS=admin@example.com
# Comma-separated allowed browser origins (leave empty to allow all in development)
CORS_ORIGIN=http://localhost:3000

# Optional: bind address. Defaults to 127.0.0.1 locally, 0.0.0.0 on a managed platform.
HOST=

# Optional rate limit ceilings
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
PLACES_RATE_LIMIT_MAX=30
